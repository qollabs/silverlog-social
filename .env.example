# MongoDB Atlas (Seoul region: ap-northeast-2)
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/silverlog-social?retryWrites=true&w=majority

# JWT secrets — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-token-secret
JWT_REFRESH_SECRET=change-me-refresh-token-secret
JWT_ACCESS_TTL=900            # 15 minutes
JWT_REFRESH_TTL=2592000       # 30 days

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MATCHING_MODEL=gpt-4o-mini

# SMS OTP (NHN Cloud / Aligo / 알리고 — popular in KR; or Twilio for global)
SMS_PROVIDER=aligo
SMS_API_KEY=
SMS_USER_ID=
SMS_SENDER=02-0000-0000

# Firebase Admin (for FCM push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ=Asia/Seoul
